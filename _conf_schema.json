{
  "mode_on_words": {
    "type": "string",
    "description": "进入 GalGame 模式的说法",
    "hint": "英文逗号分隔。整条消息与其中任意一个完全一致时才进入模式，避免“gal模式是什么”误触发；推荐同时使用 /gal start。群聊里 @机器人 的前缀会被忽略。",
    "default": "gal,进入gal模式,gal模式,切换gal模式,开始gal,gal启动,启动gal,开始gal模式,开启gal,开gal"
  },
  "mode_off_words": {
    "type": "string",
    "description": "退出 GalGame 模式的说法",
    "hint": "英文逗号分隔，整条消息完全一致才退出。推荐同时使用 /gal stop。",
    "default": "退出gal模式,退出gal,结束gal,退出游戏,关闭gal"
  },
  "mode_idle_minutes": {
    "type": "int",
    "description": "GalGame 模式最长挂多久（分钟）",
    "hint": "这么久没有互动就自动退出模式，避免下次回来还是出图。",
    "default": 120,
    "slider": {
      "min": 5,
      "max": 1440,
      "step": 5
    }
  },
  "option_ttl": {
    "type": "int",
    "description": "选项有效时长（秒）",
    "hint": "出图之后，用户多久内回字母/数字还算数；超时按普通消息处理。",
    "default": 600,
    "slider": {
      "min": 30,
      "max": 3600,
      "step": 30
    }
  },
  "gal_debounce_enabled": {
    "type": "bool",
    "description": "gal 模式内置防抖",
    "hint": "把同一用户连续发来的几条消息合并成一轮，再请求模型。",
    "default": true
  },
  "gal_debounce_seconds": {
    "type": "float",
    "description": "防抖静默时间（秒）",
    "hint": "最后一条消息后等待多久再请求模型。",
    "default": 1.0,
    "slider": {
      "min": 0.2,
      "max": 5.0,
      "step": 0.1
    }
  },
  "gal_debounce_max_seconds": {
    "type": "float",
    "description": "防抖最长等待（秒）",
    "hint": "用户一直连发时，最多等这么久就合并请求。",
    "default": 5.0,
    "slider": {
      "min": 1.0,
      "max": 15.0,
      "step": 0.5
    }
  },
  "bot_label": {
    "type": "string",
    "description": "台词框前的名字标签",
    "hint": "对话框里蓝色小标签上写的字。",
    "default": "小鲸鱼"
  },
  "default_say": {
    "type": "string",
    "description": "台词为空时的兜底句子",
    "hint": "模型没有给出 say 时，台词框显示这句。",
    "default": "这几个方向，你想先聊哪个？"
  },
  "say_max_units": {
    "type": "float",
    "description": "单行台词最大显示宽度（全角字）",
    "hint": "超过会截断并补省略号；多行模式下每行独立计算。",
    "default": 46.0,
    "slider": {
      "min": 24,
      "max": 72,
      "step": 1
    }
  },
  "dialogue_max_lines": {
    "type": "int",
    "description": "单图最多对话行数",
    "hint": "1~3。默认 3；模型会优先输出 2~3 行连续对话。",
    "default": 3,
    "slider": {
      "min": 1,
      "max": 3,
      "step": 1
    }
  },
  "voice_line_gap_ms": {
    "type": "int",
    "description": "多行语音每句之间的静音毫秒数",
    "hint": "默认 1000ms；越大停顿越明显。",
    "default": 1000,
    "slider": {
      "min": 0,
      "max": 2500,
      "step": 100
    }
  },
  "option_max_units": {
    "type": "float",
    "description": "选项字数上限",
    "hint": "同上算法，管 A/B/C/D 那几行选项文字。卡片宽度有限，建议不超过 20。",
    "default": 16.0,
    "slider": {
      "min": 4,
      "max": 20,
      "step": 1
    }
  },
  "free_option_hint": {
    "type": "string",
    "description": "自由输入位的提示文案",
    "hint": "选项图最后一行显示的文字，字母位固定为 0，用户回 0 或直接说话都算自由输入。",
    "default": "✎ 自己说点什么…"
  },
  "free_input_enabled": {
    "type": "bool",
    "description": "显示自由输入位",
    "hint": "关闭后只显示 A/B/C/D 选项；用户仍然可以直接说话触发自由输入处理。",
    "default": true
  },
  "emotion_default_file": {
    "type": "string",
    "description": "默认立绘（没给表情标签时用）",
    "hint": "相对 assets 目录的文件名，笑的那张填这里。",
    "default": "whale_girl_moe.webp"
  },
  "emotion_map": {
    "type": "dict",
    "description": "表情 → 立绘文件（内置角色）",
    "hint": "键是视觉情绪组，值是 assets 下的相对路径。自定义角色请在资源工作台上传。",
    "items": {},
    "template_schema": {
      "happy": {
        "name": "开心",
        "type": "string",
        "default": "whale_girl_moe.webp"
      },
      "angry": {
        "name": "生气",
        "type": "string",
        "default": "emotions/angry.webp"
      },
      "surprised": {
        "name": "惊讶",
        "type": "string",
        "default": "emotions/surprised.webp"
      },
      "calm": {
        "name": "平静",
        "type": "string",
        "default": "whale_girl_moe.webp"
      },
      "sad": {
        "name": "难过",
        "type": "string",
        "default": "emotions/teary.webp"
      },
      "shy": {
        "name": "害羞",
        "type": "string",
        "default": "emotions/blank.webp"
      },
      "tired": {
        "name": "疲惫",
        "type": "string",
        "default": "emotions/frown.webp"
      },
      "worried": {
        "name": "担心",
        "type": "string",
        "default": "emotions/blank.webp"
      },
      "moved": {
        "name": "感动",
        "type": "string",
        "default": "emotions/blank.webp"
      },
      "confused": {
        "name": "困惑",
        "type": "string",
        "default": "emotions/frown.webp"
      },
      "indifferent": {
        "name": "无语",
        "type": "string",
        "default": "emotions/frown.webp"
      },
      "scared": {
        "name": "害怕",
        "type": "string",
        "default": "emotions/endure.webp"
      }
    },
    "default": {
      "happy": "whale_girl_moe.webp",
      "angry": "emotions/angry.webp",
      "surprised": "emotions/surprised.webp",
      "calm": "whale_girl_moe.webp",
      "sad": "emotions/teary.webp",
      "shy": "emotions/blank.webp",
      "tired": "emotions/frown.webp",
      "worried": "emotions/blank.webp",
      "moved": "emotions/blank.webp",
      "confused": "emotions/frown.webp",
      "indifferent": "emotions/frown.webp",
      "scared": "emotions/endure.webp"
    }
  },
  "background_file": {
    "type": "string",
    "description": "固定背景文件名",
    "hint": "填 background 目录下的文件名就固定用这张；留空则按“背景模式”选择。",
    "default": ""
  },
  "background_mode": {
    "type": "string",
    "description": "背景选择方式",
    "options": [
      "session",
      "random",
      "fixed"
    ],
    "labels": [
      "每个会话固定一张（推荐）",
      "每轮随机",
      "固定使用指定背景"
    ],
    "hint": "session：同一会话内保持同一张背景，换场景可 /gal reset；random：每轮随机；fixed：使用上方固定文件名。",
    "default": "session"
  },
  "background_blur": {
    "type": "int",
    "description": "背景模糊强度",
    "hint": "单位 px，0 是不模糊。",
    "default": 20,
    "slider": {
      "min": 0,
      "max": 60,
      "step": 1
    }
  },
  "box_alpha": {
    "type": "float",
    "description": "对话框不透明度",
    "hint": "0.2～1.0，越大越实。立绘在框后透出较多时建议 0.94 以上。",
    "default": 0.94,
    "slider": {
      "min": 0.2,
      "max": 1.0,
      "step": 0.02
    }
  },
  "show_icons": {
    "type": "bool",
    "description": "显示右下角系统图标",
    "hint": "查看对话、自动播放、快进、存档、读档、设置那一排装饰图标。",
    "default": true
  },
  "show_turn_label": {
    "type": "bool",
    "description": "显示右下角幕数",
    "hint": "在对话框底部显示“序章 / 第 N 幕”。",
    "default": true
  },
  "say_font_size": {
    "type": "int",
    "description": "台词基准字号",
    "hint": "单位 px。台词过长时会自动缩小 2～4px。",
    "default": 26,
    "slider": {
      "min": 18,
      "max": 34,
      "step": 1
    }
  },
  "image_quality": {
    "type": "int",
    "description": "出图 JPEG 质量",
    "hint": "1～100，越大越清晰、文件越大。",
    "default": 90,
    "slider": {
      "min": 30,
      "max": 100,
      "step": 1
    }
  },
  "render_endpoint": {
    "type": "string",
    "description": "文转图服务地址（可选，多个用逗号分隔）",
    "hint": "留空使用 AstrBot 全局 T2I 设置。可填一个或多个端点，例如 https://t2i.soulter.top/text2img,https://t2i.rcfortress.site/text2img；失败会自动切换。",
    "default": ""
  },
  "voice_enabled": {
    "type": "bool",
    "description": "台词配语音",
    "hint": "gal 图发出后，把对话框里的台词念成一条语音。使用 AstrBot 的 TTS 提供商。",
    "default": true
  },
  "voice_probability": {
    "type": "float",
    "description": "配音概率",
    "hint": "每条台词发语音的概率，1 表示每条都配，0 等于关闭。",
    "default": 1.0,
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.1
    }
  },
  "tts_provider_id": {
    "type": "string",
    "description": "指定 TTS 提供商",
    "hint": "留空则使用 AstrBot 当前会话的 TTS 提供商。",
    "default": "",
    "_special": "select_provider_tts"
  },
  "tts_emotion_mode": {
    "type": "string",
    "description": "TTS 情绪标签模式",
    "hint": "auto：只有 FishAudio 才加 [happy] 这类内联标签；fishaudio：强制加；off：不加。",
    "options": [
      "auto",
      "fishaudio",
      "off"
    ],
    "labels": [
      "自动（按提供商）",
      "FishAudio 内联标签",
      "关闭"
    ],
    "default": "auto"
  },
  "gal_provider_id": {
    "type": "string",
    "description": "GalGame 模式使用的模型",
    "hint": "留空则跟随当前会话模型。也可以用 /gal model 临时指定。",
    "default": "",
    "_special": "select_provider"
  },
  "avatar_enabled": {
    "type": "bool",
    "description": "在对话框里显示提问者头像",
    "hint": "通过 QQ 头像接口获取；关闭后显示昵称首字占位。",
    "default": true
  },
  "avatar_size": {
    "type": "int",
    "description": "头像请求尺寸",
    "hint": "实际显示只有 26px，100 已经足够；网络差可调小。",
    "default": 100,
    "slider": {
      "min": 40,
      "max": 640,
      "step": 20
    }
  }
}
